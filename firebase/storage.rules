
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin'
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.status == 'approved';
    }

    // 공개 표지 이미지
    match /covers/{fileName} {
      allow read: if true;
      allow write: if admin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 원본 회차 이미지는 클라이언트에서 직접 읽지 못한다.
    // 백엔드에서 구매 권한을 확인한 뒤 전달한다.
    match /episodes/{allPaths=**} {
      allow read, write: if false;
    }

    // 나머지 경로는 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
